generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
  STUDENT
  SHOP_MANAGER
  WAREHOUSE_MANAGER
  TRAINING_CENTER_MANAGER
}

model User {
  id           String   @id @default(cuid())
  // The single, global, system-assigned identifier for every role, formatted
  // as GSM-001, GSM-002, ... It expands past 999 (GSM-1000, GSM-10001, ...) and
  // is never typed by a user. The database sequence plus this default make
  // allocation safe under concurrent user creation, and the @unique constraint
  // is a final guard against duplicates.
  customUserId String   @unique @default(dbgenerated("next_custom_user_id()"))
  phone        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- Student Information ---
  // `fullName` is the student's own name; it is the second field collected during
  // registration, right after the batch number.
  fullName         String?
  // Nullable because only students have a course. Values are constrained by a
  // database CHECK and the student DTO, while existing users remain NULL.
  courseName       String?
  batchNo          String?
  fatherName       String?
  motherName       String?
  presentAddress   String?
  permanentAddress String?
  occupation       String?

  // --- Contact Details ---
  // `phone` above is the student's own number (and doubles as the password);
  // `guardianPhone` is the parent/guardian's number. `email` is optional.
  guardianPhone    String?
  email            String?

  // --- Student Identification ---
  // At least one of nidNumber / birthRegistrationNumber is required for
  // students. The constraint is enforced at the DTO/service layer because a
  // database CHECK cannot be conditional on `role`.
  nidNumber               String?
  birthRegistrationNumber String?

  // --- Student Photo & Documents ---
  studentPhoto          String?
  studentNidFrontImage  String?
  studentNidBackImage   String?
  guardianNidFrontImage String?
  guardianNidBackImage  String?

  // Fee snapshot: the course fee at the time of enrolment. Stored so that a
  // later change to the global setting does not silently alter an existing
  // student's due balance.
  courseFee Int?

  payments Payment[]

  @@index([nidNumber])
  @@index([birthRegistrationNumber])
  @@index([batchNo])
  @@index([fullName])
  @@index([guardianPhone])
  @@index([email])
  @@index([role])
}

model Setting {
  id        String   @id @default(cuid())
  address   String?
  phone     String?
  email     String?
  // Course fees in taka. Snapshotted onto the student at enrolment time.
  courseFeesMobileRepairing Int?
  courseFeesEnglishSpeaking Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount    Int      // stored in taka (whole number)
  note      String?
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([paidAt])
}
