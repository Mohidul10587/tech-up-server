generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
  STUDENT
  SHOP_MANAGER
  WAREHOUSE_MANAGER
  TRAINING_CENTER_MANAGER
}

model User {
  id           String   @id @default(cuid())
  // Student-only auto-assigned identifier: {batchNo}{serial}, e.g. 301, 302, 1001.
  // NULL for non-student roles. Generated in application code (not a DB sequence)
  // so it can embed the batch number.
  studentId    String?  @unique
  phone        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- Student Information ---
  // `fullName` is the student's own name; it is the second field collected during
  // registration, right after the batch number.
  fullName         String?
  // Nullable because only students have a course. Values are constrained by a
  // database CHECK and the student DTO, while existing users remain NULL.
  courseName       String?
  batchNo          String?
  fatherName       String?
  motherName       String?
  presentAddress   String?
  permanentAddress String?
  occupation       String?

  // --- Contact Details ---
  // `phone` above is the student's own number (and doubles as the password);
  // `guardianPhone` is the parent/guardian's number. `email` is optional.
  guardianPhone    String?
  email            String?

  // --- Student Identification ---
  // At least one of nidNumber / birthRegistrationNumber is required for
  // students. The constraint is enforced at the DTO/service layer because a
  // database CHECK cannot be conditional on `role`.
  nidNumber               String?
  birthRegistrationNumber String?

  // --- Student Photo & Documents ---
  studentPhoto          String?
  studentNidFrontImage  String?
  studentNidBackImage   String?
  guardianNidFrontImage String?
  guardianNidBackImage  String?

  // Fee snapshot: the course fee at the time of enrolment. Stored so that a
  // later change to the global setting does not silently alter an existing
  // student's due balance.
  courseFee Int?

  payments Payment[]

  @@index([nidNumber])
  @@index([birthRegistrationNumber])
  @@index([batchNo])
  @@index([studentId])
  @@index([fullName])
  @@index([guardianPhone])
  @@index([email])
  @@index([role])
}

model Setting {
  id        String   @id @default(cuid())
  address   String?
  phone     String?
  email     String?
  // Course info stored as JSON objects.
  // Each object: { name, slug, durationMonths, regularFee, presentFee, description }
  mobileRepairingCourse Json?
  englishSpeakingCourse Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Batch {
  id         String   @id @default(cuid())
  /// The batch identifier shown to users, e.g. "1", "2", "10". Must be unique per course.
  name       String
  /// Which course this batch belongs to.
  courseName String   @default("Mobile Repairing")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([name, courseName])
}

model Payment {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount    Int      // stored in taka (whole number)
  note      String?
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([paidAt])
}
