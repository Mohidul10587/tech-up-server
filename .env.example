DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
JWT_SECRET="use-a-long-random-secret"
FRONTEND_URL="http://localhost:3000"
ADMIN_PHONE=01700000000
ADMIN_PASSWORD=01700000000
# Render/testing: Cloudinary (required there)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder for student photos/documents.
CLOUDINARY_FOLDER=gsm-tech/students

# Final VPS production: set STORAGE_PROVIDER=minio and configure these values.
# MINIO_ENDPOINT=minio.example.com
# MINIO_PORT=9000
# MINIO_USE_SSL=true
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=gsm-tech
# Browser-reachable base URL. The bucket/reverse proxy must allow read access
# for these stored image URLs.
# MINIO_PUBLIC_URL=https://minio.example.com
